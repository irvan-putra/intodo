<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101828" android:padding="20dp">

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Instinct" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Reminders and todos" android:textColor="#98A2B3" android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout android:id="@+id/pairingPane" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pair this phone with Instinct" android:textColor="#F59E0B" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="#D0D5DD" android:textSize="14sp"
            android:text="1. Tap the button below to create this phone's private key.\n2. Send the shown public key to Instinct on WhatsApp (it is not secret).\n3. Instinct encrypts your list so only this phone can read it.\n4. Come back and tap Sync now." />
        <Button android:id="@+id/generateKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Create pairing key" />
        <TextView android:id="@+id/pubkeyLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Your public key:" android:textColor="#98A2B3"
            android:textSize="12sp" android:visibility="gone" />
        <TextView android:id="@+id/pubkey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="12sp" android:textIsSelectable="true"
            android:background="#1D2939" android:padding="12dp" android:visibility="gone" />
        <Button android:id="@+id/copyKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Copy public key" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:id="@+id/listPane" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:divider="#1D2939" android:dividerHeight="1dp" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Nothing synced yet. Tap Sync now." android:textColor="#98A2B3" android:textSize="14sp"
            android:padding="12dp" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/lastSync" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#667085" android:textSize="12sp" />
    <Button android:id="@+id/syncNow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Sync now" android:visibility="gone" />
    <TextView android:id="@+id/repair" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Re-pair this phone" android:textColor="#667085"
        android:textSize="13sp" android:padding="8dp" android:visibility="gone" />
    <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="v0.3-test" android:textColor="#475467" android:textSize="11sp" android:gravity="end" />
</LinearLayout>
