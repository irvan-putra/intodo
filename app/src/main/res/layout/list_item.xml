<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
    <TextView android:id="@+id/item_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F2F4F7" android:textSize="16sp" />
    <TextView android:id="@+id/item_note" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F59E0B" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>
