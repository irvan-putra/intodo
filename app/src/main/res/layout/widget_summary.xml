<?xml version="1.0" encoding="utf-8"?>
<!-- One-cell counter. Full list remains in the app and in enlarged widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_summary_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/widget_summary_count" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="center" android:background="@drawable/widget_counter_circle" android:gravity="center"
        android:text="0" android:textSize="18sp" android:includeFontPadding="false" android:maxLines="1"
        android:textColor="#F2F4F7" />
</FrameLayout>
